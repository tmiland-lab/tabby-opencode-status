  "description": "Native Tabby plugin: paint tab color / progress / title from opencode session status, with session restore",
  "author": {
    "name": "tmiland",
    "email": "326116980+tmiland@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
